<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Игнорировать классы-конфигурации -->
    <suppress files=".*Config\.java" checks=".*"/>
    <!-- Игнорировать классы-приложения -->
    <suppress files=".*Application\.java" checks=".*"/>
    <!-- Игнорировать DTO -->
    <suppress files=".*[Dd]to.*" checks=".*"/>
    <!-- Игнорировать тесты -->
    <suppress files=".*[\\/]test[\\/].*" checks=".*"/>
</suppressions>
